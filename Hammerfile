desc 'Build, install, and run Herdr Tools'

task :build do
  desc 'Build and sign build/Herdr_Tools.app'
  proc { sh 'zsh build.sh' }
end

task :install do
  desc 'Build, install, and restart Herdr Tools in /Applications'
  needs :build
  proc do
    sh 'ditto build/Herdr_Tools.app /Applications/Herdr_Tools.app'
    sh 'codesign --verify --strict /Applications/Herdr_Tools.app'
    sh 'touch /Applications/Herdr_Tools.app'
    sh '/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f /Applications/Herdr_Tools.app'
    sh 'pkill -x HerdrTools || true'
    sh 'while pgrep -x HerdrTools >/dev/null; do sleep 0.1; done'
    sh 'open /Applications/Herdr_Tools.app'
    say.green 'Installed and restarted /Applications/Herdr_Tools.app'
  end
end

task :run do
  desc 'Open the installed Herdr Tools app'
  proc { sh 'open /Applications/Herdr_Tools.app' }
end

task :test do
  desc 'Run the Swift tests'
  proc { sh 'swift test' }
end

task :version do
  desc 'Stamp .version with the commit count on main, then print it'
  proc do
    ref = system('git rev-parse --verify -q main >/dev/null 2>&1') ? 'main' : 'HEAD'
    count = `git rev-list --count #{ref}`.strip
    error 'could not count commits' unless count.match?(/\A\d+\z/)
    File.write('.version', "v#{count}\n")
    say `zsh tools/version.sh`.strip
  end
end

task :deploy do
  desc 'Push, then publish a universal macOS release, keeping only the latest'
  proc do
    asset = 'Herdr_Tools.zip'

    ENV['UNIVERSAL'] = '1'
    sh 'zsh build.sh'
    ENV.delete('UNIVERSAL')

    tag = `zsh tools/version.sh`.strip
    error 'could not determine version' unless tag.match?(/\Av\d+\.\d+\.\d+\z/)
    version = tag.delete_prefix('v')

    zip = "build/#{asset}"
    File.delete(zip) if File.exist?(zip)
    sh "ditto -c -k --keepParent build/Herdr_Tools.app #{zip}"
    digest = `shasum -a 256 #{zip}`.split.first
    error 'shasum failed' unless digest
    File.write("build/#{asset}.sha256", "#{digest}  #{asset}\n")

    sh 'git push origin HEAD'

    `gh release list --limit 100 --json tagName --jq '.[].tagName'`.split.each do |old|
      sh "gh release delete #{old} --yes --cleanup-tag"
      `git tag -d #{old} 2>/dev/null`
    end

    sh "gh release create #{tag} #{zip} build/#{asset}.sha256 " \
       "--title 'Herdr Tools #{version}' --generate-notes --latest"
    say.green "Released #{tag}"
  end
end
